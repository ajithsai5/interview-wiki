# Obsidian workspace state (keep your vault config out of git)
.obsidian/workspace*
.obsidian/cache

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini

# Local Claude Code tooling (machine-specific paths, e.g. preview launch config)
.claude/

# Self-hosted sync secrets (DB credentials + sync key) — never commit
server/config.php

# Build artifact (regenerate with: python tools/make_bundle.py)
dist/

# Deploy credentials (FTP host/user/password) — never commit
deploy-config.json
